# 统一行尾，避免 Windows 与 macOS/Linux 之间产生无意义的 CRLF 差异
* text=auto eol=lf

*.md    text eol=lf
*.sql   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.jar   binary
